# ShipDude configuration. Copy to `.env` and adjust as needed.
# All values are optional; the defaults shown below are what ShipDude uses.

# Runtime environment label (development | production).
APP_ENV=development

# HTTP port the portal listens on.
APP_PORT=8080

# Filesystem path of the embedded SQLite database. The AES-256 encryption key
# is generated beside it as `encryption.key` on first run.
DB_PATH=./config/shipdude.db

# Optional GitHub OAuth fallback used before credentials are saved through the
# settings modal. Prefer configuring these in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional personal access token used as a fallback GitHub session.
GITHUB_OAUTH_TOKEN=

# Defaults applied when a caller omits SSH connection details.
DEFAULT_SSH_PORT=22
DEFAULT_SSH_USER=root
